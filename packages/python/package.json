{
  "name": "@vx-oss/docs-python",
  "version": "1.0.3",
  "description": "The built-in Python docgen for Fumadocs",
  "keywords": [
    "Docs",
    "Python"
  ],
  "homepage": "https://vezham.com",
  "license": "MIT",
  "author": "Fuma Nama",
  "repository": {
    "type": "git",
    "url": "https://github.com/vezham/fumadocs",
    "directory": "packages/python"
  },
  "files": [
    "fumapy",
    "pyproject.toml",
    "styles",
    "dist"
  ],
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./preset.css": "./styles/preset.css",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "dev": "tsdown --watch",
    "lint": "oxlint .",
    "types:check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "cnfast": "^0.1.0",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "lucide-react": "^1.34.0",
    "mdast-util-mdx": "^3.0.0",
    "remark": "^15.0.1",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "vfile": "^6.0.3"
  },
  "devDependencies": {
    "@types/estree": "^1.0.9",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsconfig": "workspace:*",
    "tsdown": "0.22.14",
    "vitest": "^4.1.11",
    "@vx-oss/docs-core": "workspace:*",
    "@vx-oss/docs-react": "workspace:*"
  },
  "peerDependencies": {
    "@types/hast": "*",
    "@types/mdx": "*",
    "@types/react": "*",
    "react": "19.x.x",
    "@vx-oss/docs-core": "^1.0.1",
    "@vx-oss/docs-react": "^1.0.1"
  },
  "peerDependenciesMeta": {
    "@types/hast": {
      "optional": true
    },
    "@types/mdx": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    }
  }
}
