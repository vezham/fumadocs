{
  "name": "@vx-oss/docs-language",
  "version": "1.0.4",
  "description": "Common language packs for Fumadocs",
  "keywords": [
    "documentation",
    "fumadocs"
  ],
  "homepage": "https://vezham.com",
  "license": "MIT",
  "author": "Fuma Nama",
  "repository": {
    "type": "git",
    "url": "https://github.com/vezham/fumadocs",
    "directory": "packages/language"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./zh-cn": "./dist/zh-cn.js",
    "./zh-tw": "./dist/zh-tw.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "dev": "tsdown --watch --clean false",
    "lint": "oxlint .",
    "types:check": "tsc --noEmit"
  },
  "devDependencies": {
    "@vx-oss/docs-api": "workspace:*",
    "@vx-oss/docs-asyncapi": "workspace:*",
    "tsconfig": "workspace:*",
    "tsdown": "0.22.14",
    "typescript": "^6.0.3",
    "@vx-oss/docs-core": "workspace:*",
    "@vx-oss/docs-openapi": "workspace:*",
    "@vx-oss/docs-react": "workspace:*",
    "@vx-oss/docs-story": "workspace:*"
  },
  "peerDependencies": {
    "@vx-oss/docs-api": "^1.0.4",
    "@vx-oss/docs-asyncapi": "^1.0.4",
    "@vx-oss/docs-core": "^1.0.4",
    "@vx-oss/docs-openapi": "^1.0.4",
    "@vx-oss/docs-react": "^1.0.4",
    "@vx-oss/docs-story": "^1.0.4"
  },
  "peerDependenciesMeta": {
    "@vx-oss/docs-api": {
      "optional": true
    },
    "@vx-oss/docs-asyncapi": {
      "optional": true
    },
    "@vx-oss/docs-core": {
      "optional": true
    },
    "@vx-oss/docs-openapi": {
      "optional": true
    },
    "@vx-oss/docs-react": {
      "optional": true
    },
    "@vx-oss/docs-story": {
      "optional": true
    }
  }
}
