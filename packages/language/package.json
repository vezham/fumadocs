{
  "name": "@fumadocs/language",
  "version": "0.2.4",
  "description": "Common language packs for Fumadocs",
  "keywords": [
    "documentation",
    "fumadocs"
  ],
  "homepage": "https://fumadocs.dev",
  "license": "MIT",
  "author": "Fuma Nama",
  "repository": "github:fuma-nama/fumadocs",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./zh-cn": "./dist/zh-cn.js",
    "./zh-tw": "./dist/zh-tw.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "dev": "tsdown --watch --clean false",
    "lint": "oxlint .",
    "types:check": "tsc --noEmit"
  },
  "devDependencies": {
    "@fumadocs/api-docs": "workspace:*",
    "@fumadocs/asyncapi": "workspace:*",
    "tsconfig": "workspace:*",
    "tsdown": "0.22.14",
    "typescript": "^6.0.3",
    "@vezham/docs-core": "workspace:*",
    "@vezham/docs-openapi": "workspace:*",
    "@vezham/docs-react": "workspace:*",
    "@vezham/docs-story": "workspace:*"
  },
  "peerDependencies": {
    "@fumadocs/api-docs": "*",
    "@fumadocs/asyncapi": "*",
    "@vezham/docs-core": "*",
    "@vezham/docs-openapi": "*",
    "@vezham/docs-react": "*",
    "@vezham/docs-story": "*"
  },
  "peerDependenciesMeta": {
    "@fumadocs/api-docs": {
      "optional": true
    },
    "@fumadocs/asyncapi": {
      "optional": true
    },
    "@vezham/docs-core": {
      "optional": true
    },
    "@vezham/docs-openapi": {
      "optional": true
    },
    "@vezham/docs-react": {
      "optional": true
    },
    "@vezham/docs-story": {
      "optional": true
    }
  }
}
