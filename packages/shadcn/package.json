{
  "name": "@vx-oss/docs-shadcn",
  "version": "1.0.6",
  "description": "Shadcn UI integration for Fumadocs.",
  "keywords": [
    "Fumadocs"
  ],
  "license": "MIT",
  "author": "Fuma Nama",
  "repository": {
    "type": "git",
    "url": "https://github.com/vezham/fumadocs",
    "directory": "packages/shadcn"
  },
  "files": [
    "css",
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./rsc": "./dist/rsc.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "dev": "tsdown --watch",
    "lint": "oxlint .",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "@shikijs/transformers": "^4.4.3",
    "zod-3": "npm:zod@^3.25.76"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "@types/react": "^19.2.18",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.19.1",
    "tailwindcss": "^4.3.3",
    "tsconfig": "workspace:*",
    "tsdown": "0.22.14",
    "@vx-oss/docs-core": "workspace:*",
    "@vx-oss/docs-react": "workspace:*"
  },
  "peerDependencies": {
    "@types/react": "*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shadcn": "^4",
    "@vx-oss/docs-core": "*",
    "@vx-oss/docs-react": "*"
  },
  "peerDependenciesMeta": {
    "shadcn": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    }
  }
