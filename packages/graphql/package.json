{
  "name": "@vx-oss/docs-graphql",
  "version": "1.0.3",
  "description": "Generate docs for your GraphQL schema",
  "keywords": [
    "Docs",
    "Fumadocs",
    "GraphQL"
  ],
  "homepage": "https://vezham.com",
  "license": "MIT",
  "author": "Fuma Nama",
  "repository": {
    "type": "git",
    "url": "https://github.com/vezham/fumadocs",
    "directory": "packages/graphql"
  },
  "files": [
    "css",
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./i18n": "./dist/i18n.js",
    "./server": "./dist/server/index.js",
    "./ui": "./dist/ui/index.js",
    "./package.json": "./package.json",
    "./css/*": "./css/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "dev": "tsdown --watch --clean false",
    "lint": "oxlint .",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "@fuma-translate/react": "^1.0.2",
    "@vx-oss/docs-api": "workspace:*",
    "@vx-oss/docs-stf": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "cnfast": "^0.1.0",
    "github-slugger": "^2.0.0",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "lucide-react": "^1.34.0",
    "remark": "^15.0.1",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/oxide": "^4.3.3",
    "@types/node": "26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "graphql": "^17.0.2",
    "tailwindcss": "^4.3.3",
    "tsconfig": "workspace:*",
    "tsdown": "0.22.14",
    "@vx-oss/docs-core": "workspace:*",
    "@vx-oss/docs-react": "workspace:*"
  },
  "peerDependencies": {
    "@types/react": "*",
    "graphql": "^17.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@vx-oss/docs-core": "^1.0.1",
    "@vx-oss/docs-react": "^1.0.1"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  }
}
