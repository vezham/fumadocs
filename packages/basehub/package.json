{
  "name": "@vx-oss/docs-basehub",
  "version": "1.0.2",
  "description": "The official BaseHub integration for Fumadocs",
  "keywords": [
    "Docs",
    "Fumadocs"
  ],
  "homepage": "https://vezham.com",
  "license": "MIT",
  "author": "Fuma Nama",
  "repository": {
    "type": "git",
    "url": "https://github.com/vezham/fumadocs",
    "directory": "packages/basehub"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/toc.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "dev": "tsdown --watch --clean false",
    "lint": "oxlint .",
    "types:check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "26.3.0",
    "@types/react": "^19.2.18",
    "basehub": "9.6.0",
    "fuma-cli": "^0.1.1",
    "react": "^19.2.8",
    "tsconfig": "workspace:*",
    "tsdown": "0.22.14",
    "typescript": "^6.0.3",
    "@vx-oss/docs-core": "workspace:*",
    "@vx-oss/docs-react": "workspace:*"
  },
  "peerDependencies": {
    "@types/react": "*",
    "basehub": "9.x.x",
    "react": "^19.2.0",
    "@vx-oss/docs-core": "^1.0.1"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  }
}
