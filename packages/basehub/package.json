{
  "name": "@vx-oss/docs-basehub",
  "version": "1.0.6",
  "description": "The official BaseHub integration for Fumadocs",
  "keywords": [
    "Docs",
    "Fumadocs"
  ],
  "homepage": "https://vezham.com",
  "license": "MIT",
  "author": "Fuma Nama",
  "repository": {
    "type": "git",
    "url": "https://github.com/vezham/fumadocs",
    "directory": "packages/basehub"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/toc.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "dev": "tsdown --watch --clean false",
    "lint": "oxlint .",
    "types:check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "@types/react": "^19.2.18",
    "basehub": "9.6.0",
    "fuma-cli": "^0.1.1",
    "@vx-oss/docs-core": "workspace:*",
    "@vx-oss/docs-react": "workspace:*",
    "react": "^19.2.8",
    "tsconfig": "workspace:*",
    "tsdown": "0.22.14",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@types/react": "*",
    "basehub": "9.x.x",
    "@vx-oss/docs-core": "*",
    "react": "^19.2.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  }
}
