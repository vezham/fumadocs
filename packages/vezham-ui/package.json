{
  "name": "@vx-oss/docs-vezham-ui",
  "version": "1.0.4",
  "description": "Vezham UI implementation package for Vezham Docs",
  "keywords": [
    "Docs",
    "Fumadocs",
    "Vezham",
    "react"
  ],
  "homepage": "https://vezham.com",
  "license": "MIT",
  "author": "Fuma Nama",
  "repository": {
    "type": "git",
    "url": "https://github.com/vezham/fumadocs",
    "directory": "packages/vezham-ui"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "clean": "rimraf dist",
    "dev": "node scripts/build.mjs",
    "lint": "oxlint .",
    "types:check": "node scripts/build.mjs"
  },
  "dependencies": {
    "@vezham/react-v3": "npm:@heroui/react@3.2.4",
    "@vezham/styles-v3": "npm:@heroui/styles@3.2.4"
  },
  "peerDependencies": {
    "@types/react": "*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  }
}
