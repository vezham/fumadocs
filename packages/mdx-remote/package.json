{
  "name": "@vx-oss/docs-mdx-remote",
  "version": "1.0.7",
  "description": "The remote MDX files adapter for Fumadocs",
  "keywords": [
    "Docs",
    "fumadocs"
  ],
  "homepage": "https://vezham.com",
  "license": "MIT",
  "author": "Fuma Nama",
  "repository": {
    "type": "git",
    "url": "https://github.com/vezham/fumadocs",
    "directory": "packages/mdx-remote"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "dev": "tsdown --watch",
    "lint": "oxlint .",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "unified": "^11.0.5",
    "vfile": "^6.0.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/mdx": "^2.0.14",
    "@types/node": "26.4.1",
    "@types/react": "^19.2.18",
    "react": "^19.2.8",
    "tinyglobby": "^0.2.17",
    "tsconfig": "workspace:*",
    "tsdown": "0.22.14",
    "@vx-oss/docs-core": "workspace:*"
  },
  "peerDependencies": {
    "@types/mdx": "*",
    "@types/react": "*",
    "react": "18.x.x || 19.x.x",
    "@vx-oss/docs-core": "*"
  },
  "peerDependenciesMeta": {
    "@types/mdx": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    }
  }
}
