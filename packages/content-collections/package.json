{
  "name": "@vx-oss/docs-content-collections",
  "version": "1.0.2",
  "description": "The Content Collections adapter for Fumadocs",
  "keywords": [
    "Content Collections",
    "Docs",
    "fumadocs"
  ],
  "homepage": "https://vezham.com",
  "license": "MIT",
  "author": "Fuma Nama",
  "repository": {
    "type": "git",
    "url": "https://github.com/vezham/fumadocs",
    "directory": "packages/content-collections"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./configuration": {
      "types": "./dist/configuration.d.ts",
      "import": "./dist/configuration.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "dev": "tsdown --watch",
    "lint": "oxlint .",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "unified": "^11.0.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@content-collections/core": "0.15.2",
    "@content-collections/mdx": "^0.2.2",
    "@types/node": "26.3.0",
    "tsconfig": "workspace:*",
    "tsdown": "0.22.14",
    "@vx-oss/docs-core": "workspace:*"
  },
  "peerDependencies": {
    "@content-collections/core": "0.x.x",
    "@content-collections/mdx": "0.x.x",
    "@vx-oss/docs-core": "^1.0.1"
  }
}
