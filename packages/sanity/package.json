{
  "name": "@vx-oss/docs-sanity",
  "version": "1.0.6",
  "description": "The official Sanity integration for Fumadocs",
  "keywords": [
    "Docs",
    "Fumadocs"
  ],
  "homepage": "https://vezham.com",
  "license": "MIT",
  "author": "Fuma Nama",
  "repository": {
    "type": "git",
    "url": "https://github.com/vezham/fumadocs",
    "directory": "packages/sanity"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./client": "./dist/client.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "dev": "tsdown --watch --clean false",
    "lint": "oxlint .",
    "types:check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@portabletext/react": "^8.0.1"
  },
  "devDependencies": {
    "@sanity/client": "^8.4.0",
    "@sanity/types": "^6.12.0",
    "@types/node": "26.4.1",
    "@types/react": "^19.2.18",
    "fuma-cli": "^0.1.1",
    "@vx-oss/docs-core": "workspace:*",
    "@vx-oss/docs-react": "workspace:*",
    "next-sanity": "^13.3.4",
    "react": "^19.2.8",
    "sanity": "^6.12.0",
    "tsconfig": "workspace:*",
    "tsdown": "0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@sanity/client": "^7.22.0 || ^8.0.0",
    "@sanity/types": "*",
    "@types/react": "*",
    "@vx-oss/docs-core": "^1.0.6",
    "next-sanity": "^12.4.0 || ^13.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "peerDependenciesMeta": {
    "@sanity/types": {
      "optional": true
    },
    "@sanity/client": {
      "optional": true
    },
    "next-sanity": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    }
  }
}
