{
  "name": "@vx-oss/docs-typescript",
  "version": "1.0.2",
  "description": "Typescript Integration for Fumadocs",
  "keywords": [
    "Docs",
    "fumadocs"
  ],
  "homepage": "https://vezham.com",
  "license": "MIT",
  "author": "Fuma Nama",
  "repository": {
    "type": "git",
    "url": "https://github.com/vezham/fumadocs",
    "directory": "packages/typescript"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "dev": "tsdown --watch",
    "lint": "oxlint .",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "estree-util-value-to-estree": "^3.5.0",
    "hast-util-to-estree": "^3.1.3",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "remark": "^15.0.1",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.4.3",
    "ts-morph": "^28.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@types/estree": "^1.0.9",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "mdast-util-mdx": "^3.0.0",
    "tsconfig": "workspace:*",
    "tsdown": "0.22.14",
    "typescript": "^6.0.3",
    "vfile": "^6.0.3",
    "@vx-oss/docs-core": "workspace:*",
    "@vx-oss/docs-react": "workspace:*"
  },
  "peerDependencies": {
    "@types/estree": "*",
    "@types/hast": "*",
    "@types/mdast": "*",
    "@types/react": "*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@vx-oss/docs-core": "^1.0.1",
    "@vx-oss/docs-react": "^1.0.1"
  },
  "peerDependenciesMeta": {
    "@types/estree": {
      "optional": true
    },
    "@types/hast": {
      "optional": true
    },
    "@types/mdast": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    },
    "@vx-oss/docs-react": {
      "optional": true
    }
  }
}
