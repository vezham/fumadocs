{
  "name": "@vx-oss/docs-twoslash",
  "version": "1.0.6",
  "description": "Typescript Twoslash Integration for Fumadocs",
  "keywords": [
    "Docs",
    "fumadocs"
  ],
  "homepage": "https://vezham.com",
  "license": "MIT",
  "author": "Fuma Nama",
  "repository": {
    "type": "git",
    "url": "https://github.com/vezham/fumadocs",
    "directory": "packages/twoslash"
  },
  "files": [
    "dist",
    "styles"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./twoslash.css": "./styles/twoslash.css",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    },
    "./cache-fs": {
      "types": "./dist/cache-fs.d.ts",
      "import": "./dist/cache-fs.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "dev": "tsdown --watch",
    "lint": "oxlint .",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@types/hast": "^3.0.5",
    "cn": "^0.2.4",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-to-hast": "^13.2.1",
    "typescript": "~7.0.2"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "26.4.1",
    "@types/react": "^19.2.18",
    "@vx-oss/docs-core": "workspace:*",
    "@vx-oss/docs-react": "workspace:*",
    "shiki": "4.4.3",
    "tsconfig": "workspace:*",
    "tsdown": "0.22.14"
  },
  "peerDependencies": {
    "@types/react": "*",
    "@vx-oss/docs-core": "*",
    "@vx-oss/docs-react": "*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shiki": "^4.4.3"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  }
}
