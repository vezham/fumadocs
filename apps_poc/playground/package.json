{
  "name": "playground",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "serve": "bash ./bin/server.sh",
    "preview": "bash ./bin/server.sh start",
    "build": "next build",
    "build:docs": "bun ./scripts/generators/docs.ts",
    "dev": "next dev --turbo",
    "start": "next start",
    "types:check": "fumadocs-mdx && tsc --noEmit"
  },
  "dependencies": {
    "fumadocs-core": "workspace:*",
    "fumadocs-mdx": "workspace:*",
    "fumadocs-openapi": "workspace:*",
    "fumadocs-ui": "workspace:*",
    "next": "16.0.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "shiki": "^3.13.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/mdx": "^2.0.13",
    "@types/node": "24.6.1",
    "@types/react": "^19.1.14",
    "@types/react-dom": "^19.1.9",
    "postcss": "^8.5.6",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2"
  }
}
